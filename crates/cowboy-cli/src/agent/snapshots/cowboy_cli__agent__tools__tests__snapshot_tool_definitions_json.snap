---
source: crates/cowboy-cli/src/agent/tools.rs
expression: defs
---
[
  {
    "description": "Run a shell command inside the sandbox and observe its output. Use this for builds, tests, git, and cowboy CLIs like `cowboy patch`. Each call is a FRESH shell: `cd` and `export` do not persist to the next call — pass `cwd`, or chain with `&&`. The filesystem and any listening server do persist. For reading, searching or editing files, prefer the `read`/`grep`/`ls`/`edit`/`write` tools.",
    "name": "shell",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `shell` tool.",
      "properties": {
        "command": {
          "description": "The shell command to run in the sandbox, executed with `/bin/sh -c` — which\nis dash on Debian/Ubuntu, so keep it POSIX (no `[[`, no `<(…)`, no\n`exec -a`). **Every call is a fresh shell in a fresh process**, so a `cd` or\nan `export` does not carry over to the next call; the filesystem and any\nserver left listening do. To run somewhere else, pass `cwd` or chain it:\n`cd sub && cargo test`.",
          "type": "string"
        },
        "cwd": {
          "default": null,
          "description": "Optional working directory for this command (defaults to the workspace root).\nThis is how to run in a subdirectory, since `cd` does not persist.",
          "type": [
            "string",
            "null"
          ]
        },
        "timeout_seconds": {
          "default": null,
          "description": "Optional timeout in seconds for this command. Raise it for a long test or\nbuild suite; lower it for a command you expect to be quick so a hang is cut\nshort. Omit to use the session default. The host clamps it to a ceiling.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "command"
      ],
      "title": "ShellArgs",
      "type": "object"
    }
  },
  {
    "description": "Read a file from the workspace with line numbers. Prefer this over `cat`/`sed` — the line numbers help you make precise edits.",
    "name": "read",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `read` tool.",
      "properties": {
        "limit": {
          "default": null,
          "description": "Maximum number of lines to return.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "default": null,
          "description": "1-based line to start at (default 1).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "description": "Path to the file (workspace-relative, e.g. `src/main.rs`).",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "ReadArgs",
      "type": "object"
    }
  },
  {
    "description": "Replace an exact span of text in a file. `old` must match exactly and be unique unless `replace_all` is set. To change a file in several places, pass `edits` — they apply in order and all-or-nothing, so a failure leaves the file untouched. Copy `old` from `read` output without the line-number gutter. Prefer this over `sed`/heredocs — it is precise and fails loudly if `old` is missing or ambiguous.",
    "name": "edit",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `edit` tool.",
      "properties": {
        "edits": {
          "description": "Several edits to the same file, applied in order and **all-or-nothing**:\nif any one fails, the file is left untouched. Use instead of `old`/`new`\nwhen changing a file in more than one place.",
          "items": {
            "description": "One find/replace within a single file, as an entry in `edits`.",
            "properties": {
              "new": {
                "description": "Replacement text.",
                "type": "string"
              },
              "old": {
                "description": "Exact text to replace. Must match a unique span unless `replace_all`.",
                "type": "string"
              },
              "replace_all": {
                "default": false,
                "description": "Replace every occurrence instead of requiring a unique match.",
                "type": "boolean"
              }
            },
            "required": [
              "old",
              "new"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "new": {
          "default": null,
          "description": "Replacement text. Omit when using `edits`.",
          "type": [
            "string",
            "null"
          ]
        },
        "old": {
          "default": null,
          "description": "Exact text to replace. Must match a unique span unless `replace_all`.\nOmit when using `edits`.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Path to the file to edit (workspace-relative).",
          "type": "string"
        },
        "replace_all": {
          "default": false,
          "description": "Replace every occurrence instead of requiring a unique match.",
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "title": "EditArgs",
      "type": "object"
    }
  },
  {
    "description": "Search the workspace for a regex, reporting `path:line:text`. Use this to find where something lives instead of `grep -r`/`rg` via `shell`: it skips build output, dependency directories (`target`, `node_modules`, `.git`, …), anything `.gitignore` excludes, and binary files; it caps the matches it prints, and always reports the true total so you can tell when to narrow the pattern. Set `context` for surrounding lines (like `grep -C`), `files_only` to list just the matching file paths, or `include_ignored` to search generated output too. Available in plan mode.",
    "name": "grep",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `grep` tool.",
      "properties": {
        "case_insensitive": {
          "default": false,
          "description": "Case-insensitive matching.",
          "type": "boolean"
        },
        "context": {
          "default": null,
          "description": "Lines of surrounding context to show on each side of a match (like\n`grep -C`). Match lines use `path:line:`, context lines `path:line-`.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "files_only": {
          "default": false,
          "description": "Report only the paths of files that contain a match, not the lines (like\n`grep -l`). Cheaper when you only need to know *where* something is.",
          "type": "boolean"
        },
        "glob": {
          "default": null,
          "description": "Only search files whose name or workspace-relative path matches this glob,\ne.g. `*.rs` or `src/**/mod.rs`.",
          "type": [
            "string",
            "null"
          ]
        },
        "include_ignored": {
          "default": false,
          "description": "Also search files and directories `.gitignore` excludes (build output,\ngenerated code, vendored dependencies). Off by default; the result says when\nsomething was hidden.",
          "type": "boolean"
        },
        "literal": {
          "default": false,
          "description": "Treat `pattern` as plain text rather than a regex.",
          "type": "boolean"
        },
        "max_results": {
          "default": null,
          "description": "Maximum matches to report (default 200). Totals are reported regardless.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "default": null,
          "description": "Limit the search to this file or directory (workspace-relative).",
          "type": [
            "string",
            "null"
          ]
        },
        "pattern": {
          "description": "Regular expression to search for (Rust regex syntax).",
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "title": "GrepArgs",
      "type": "object"
    }
  },
  {
    "description": "List the entries of a workspace directory, one workspace-relative path per line (directories suffixed with `/`). Use this instead of `ls`/`find` via `shell`: it skips build output, dependency directories (`target`, `node_modules`, …) and anything `.gitignore` excludes, caps the listing, and reports the true total. Pass `recursive` to walk the whole tree, `glob` to filter files, `path` to list a subdirectory, or `include_ignored` to include generated output. Available in plan mode.",
    "name": "ls",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `ls` tool.",
      "properties": {
        "glob": {
          "default": null,
          "description": "Only list files whose name or workspace-relative path matches this glob,\ne.g. `*.rs` or `src/**/mod.rs`.",
          "type": [
            "string",
            "null"
          ]
        },
        "include_ignored": {
          "default": false,
          "description": "Also list files and directories `.gitignore` excludes. Off by default; the\nresult says when something was hidden.",
          "type": "boolean"
        },
        "max_results": {
          "default": null,
          "description": "Maximum entries to report (default 500). The true total is reported regardless.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "default": null,
          "description": "Directory to list (workspace-relative). Defaults to the workspace root.",
          "type": [
            "string",
            "null"
          ]
        },
        "recursive": {
          "default": false,
          "description": "Walk the whole tree beneath `path` instead of just one level. Build and\ndependency directories (`target`, `node_modules`, …) are always skipped.",
          "type": "boolean"
        }
      },
      "title": "LsArgs",
      "type": "object"
    }
  },
  {
    "description": "Create a new file or overwrite an existing one with the given content. Parent directories are created. Prefer this over `echo >`/heredocs. Overwriting a file you have not `read` in this session is refused, as is one that changed on disk since you read it — `read` it first, or use `edit` to change only the part you mean to.",
    "name": "write",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `write` tool.",
      "properties": {
        "content": {
          "description": "Full file contents (overwrites any existing file).",
          "type": "string"
        },
        "path": {
          "description": "Path to write (workspace-relative). Parent directories are created.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content"
      ],
      "title": "WriteArgs",
      "type": "object"
    }
  },
  {
    "description": "Run a long-lived process in the background — a dev server, an API you need to send requests to, a watcher. Use this instead of `shell` for anything that does not exit on its own: a `shell` command gets its own sandbox whose whole process tree is reaped when it returns, so `&` or `nohup` there leaves you nothing, and running it in the foreground just burns the timeout. `start` (with `name`, plus `command` unless the name is defined in agent.yaml's `processes:`), then keep working — it stays reachable on localhost from your later `shell` commands. `logs` shows its recent output (it is also a file: `.cowboy/proc/<name>.log`), `list` shows what is running, `stop`/`restart` control it. Processes end with the session.",
    "name": "proc",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `proc` tool.",
      "properties": {
        "action": {
          "description": "\"start\", \"stop\", \"restart\", \"list\" or \"logs\".",
          "type": "string"
        },
        "command": {
          "default": null,
          "description": "For `start`/`restart` of an ad-hoc process: the command to run.",
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "default": null,
          "description": "For `start`/`restart`: the working directory (defaults to the workspace root).",
          "type": [
            "string",
            "null"
          ]
        },
        "lines": {
          "default": null,
          "description": "For `logs`: how many trailing lines to show (default 80).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "default": null,
          "description": "The process name — required for everything but `list`. Either a name from\n`.cowboy/agent.yaml`'s `processes:` (whose command is already defined) or one\nyou choose for an ad-hoc process, in which case pass `command` too.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action"
      ],
      "title": "ProcArgs",
      "type": "object"
    }
  },
  {
    "description": "Your durable cross-session memory (stored on the host, not in the repo). `save` a concise fact or user preference worth remembering next time (scope \"project\" by default, or \"global\" across projects); `recall` a full entry by name; `list` the index; `delete` one. The index of saved memories is shown to you at the start of each session. Do NOT use this for project conventions that belong in the repo — put those in AGENTS.md.",
    "name": "memory",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `memory` tool.",
      "properties": {
        "action": {
          "description": "What to do: \"save\", \"recall\", \"list\", or \"delete\".",
          "type": "string"
        },
        "content": {
          "default": null,
          "description": "For `save`: the full memory body to store.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "default": null,
          "description": "For `recall`/`delete`: the memory name (slug) shown in the index.",
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "default": null,
          "description": "For `save`: \"project\" (default) or \"global\".",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "default": null,
          "description": "For `save`: a one-line title (becomes the index description and slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "default": null,
          "description": "For `save`: a free-form category, e.g. \"preference\" or \"fact\".",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action"
      ],
      "title": "MemoryArgs",
      "type": "object"
    }
  },
  {
    "description": "Maintain a short, visible checklist for a multi-step task. Pass the full ordered list of `steps` (each with a `status` of \"pending\", \"in_progress\", or \"done\"); the list REPLACES the previous plan. Create a plan before starting non-trivial work, mark exactly one step \"in_progress\" at a time, and update statuses as you go. Skip it for trivial one-step tasks.",
    "name": "plan",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `plan` tool. The whole list is replaced on each call.",
      "properties": {
        "steps": {
          "description": "The full, ordered list of steps; replaces the current plan.",
          "items": {
            "description": "One step in the agent's working plan.",
            "properties": {
              "status": {
                "default": null,
                "description": "Status: \"pending\" (default), \"in_progress\", or \"done\".",
                "type": [
                  "string",
                  "null"
                ]
              },
              "step": {
                "description": "A short description of the step.",
                "type": "string"
              }
            },
            "required": [
              "step"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "steps"
      ],
      "title": "PlanArgs",
      "type": "object"
    }
  },
  {
    "description": "Publish a durable, typed output others (or a later session) can consume — a contract, summary, test result, patch, notes, etc. `publish` with a workspace `path` or inline `content`, a `kind`, a `title`, and a one-line `summary`; `list` shows this session's artifacts. Prefer publishing a concrete artifact (e.g. an API/schema contract) over describing it only in prose.",
    "name": "artifact",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `artifact` tool.",
      "properties": {
        "action": {
          "description": "\"publish\" (store an output) or \"list\" (show this session's artifacts).",
          "type": "string"
        },
        "content": {
          "default": null,
          "description": "For `publish`: inline content instead of (or in addition to) `path`.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "default": null,
          "description": "For `publish`: kind — contract|summary|patch|diff|test_result|notes|review|other.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "default": null,
          "description": "For `publish`: a workspace-relative file to publish (e.g. `docs/api.md`).",
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "default": null,
          "description": "For `publish`: a one-line summary of what the artifact is/contains.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "default": null,
          "description": "For `publish`: a short human title (defaults to the file name).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action"
      ],
      "title": "ArtifactArgs",
      "type": "object"
    }
  },
  {
    "description": "Write a structured handoff summary for whoever continues this work (a teammate, a later session, or a Ranch coordinator): goal, status, changed files, decisions, contracts, validation, risks, next steps. Call this at the end of a substantial task, just before `final`.",
    "name": "handoff",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `handoff` tool — a structured end-of-session summary that\nthe next worker (or a Ranch coordinator) can rely on.",
      "properties": {
        "changed_files": {
          "default": null,
          "description": "Files created/changed (and how), if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "contracts": {
          "default": null,
          "description": "Interfaces/contracts introduced or changed (point at published artifacts).",
          "type": [
            "string",
            "null"
          ]
        },
        "decisions": {
          "default": null,
          "description": "Important decisions made and why.",
          "type": [
            "string",
            "null"
          ]
        },
        "goal": {
          "description": "What this session set out to do.",
          "type": "string"
        },
        "next_steps": {
          "default": null,
          "description": "Recommended next steps for whoever picks this up.",
          "type": [
            "string",
            "null"
          ]
        },
        "risks": {
          "default": null,
          "description": "Known risks or gaps.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Outcome: complete | partial | blocked | failed.",
          "type": "string"
        },
        "validation": {
          "default": null,
          "description": "How the work was validated (tests/builds run and their result).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "goal",
        "status"
      ],
      "title": "HandoffArgs",
      "type": "object"
    }
  },
  {
    "description": "Ask the user to make a decision and record it durably (question, options, chosen answer, rationale) so the rationale survives and downstream work can depend on it. Use for choices that shape the work (data model, protocol, API shape), not routine questions.",
    "name": "decision",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `decision` tool — ask the user to decide and record it.",
      "properties": {
        "options": {
          "default": null,
          "description": "Optional choices to present.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "question": {
          "description": "The decision to make (asked to the user).",
          "type": "string"
        },
        "rationale": {
          "default": null,
          "description": "Optional rationale/context to record alongside the decision.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "question"
      ],
      "title": "DecisionArgs",
      "type": "object"
    }
  },
  {
    "description": "Ask the user for access to a host path outside the workspace. Use this when a command failed because a file or directory does not exist or cannot be read, and you believe the path is legitimately needed (a sibling repository, a dataset, a shared toolchain). The user approves or denies; on approval the path is available to the NEXT command, so re-run the command that failed. Already-running processes keep their old view and must be restarted. Credential stores (~/.aws, ~/.ssh, ~/.gnupg, browser profiles, …) are always refused — for those, tell the user to run `cowboy secrets add`.",
    "name": "request_path",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `request_path` tool.",
      "properties": {
        "path": {
          "description": "The host path you need, e.g. `/home/me/other-project` or `~/datasets`.",
          "type": "string"
        },
        "read_only": {
          "default": null,
          "description": "Whether read-only access is enough. Ask for read-only unless you must write:\nit is far more likely to be approved. Defaults to read-only.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason": {
          "description": "Why you need it, in one line. Shown to the user verbatim — this is what they\ndecide on, so be specific (\"the shared proto definitions the client imports\",\nnot \"for the task\").",
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "title": "RequestPathArgs",
      "type": "object"
    }
  },
  {
    "description": "Declare that you cannot proceed and need an external input (a decision, a dependency's artifact, access). Give a clear `reason` and optionally `waiting_on`. Use `unblock` once you can continue. This surfaces the session as blocked to the user / Ranch coordinator.",
    "name": "blocked",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `blocked` tool.",
      "properties": {
        "reason": {
          "description": "Why you cannot proceed (e.g. \"need the API contract from the schema work\").",
          "type": "string"
        },
        "waiting_on": {
          "default": null,
          "description": "Optional: what you're waiting on (artifact names, workstream ids, a person).",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "reason"
      ],
      "title": "BlockedArgs",
      "type": "object"
    }
  },
  {
    "description": "Clear a previously-declared blocked state once you can proceed again.",
    "name": "unblock",
    "parameters": {
      "properties": {},
      "type": "object"
    }
  },
  {
    "description": "When running a Ranch workstream and the plan itself looks wrong (a workstream is missing, unnecessary, or misscoped), DO NOT edit the ranch plan — file a proposal here. It records a pending change the user reviews and approves/rejects; the plan only changes on approval. Use `change`: add_workstream (with workstream_id/title/goal/depends_on), remove_workstream (workstream_id), or note (a concern). Outside a ranch this is unavailable.",
    "name": "propose_scope_change",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `propose_scope_change` tool.",
      "properties": {
        "change": {
          "description": "The change: \"add_workstream\", \"remove_workstream\", or \"note\" (a concern with\nno concrete edit).",
          "type": "string"
        },
        "depends_on": {
          "default": null,
          "description": "For add_workstream: ids it depends on.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "goal": {
          "default": null,
          "description": "For add_workstream: the goal/description.",
          "type": [
            "string",
            "null"
          ]
        },
        "rationale": {
          "default": null,
          "description": "Why the plan should change (what you learned that the plan didn't anticipate).",
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "description": "One-line summary of the proposed change.",
          "type": "string"
        },
        "title": {
          "default": null,
          "description": "For add_workstream: a short title.",
          "type": [
            "string",
            "null"
          ]
        },
        "workstream_id": {
          "default": null,
          "description": "For add/remove: the workstream id.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "summary",
        "change"
      ],
      "title": "ProposeScopeChangeArgs",
      "type": "object"
    }
  },
  {
    "description": "Finish the task. Provide a summary of what changed, what was validated, and any remaining risks or follow-up work.",
    "name": "final",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `final` tool.",
      "properties": {
        "message": {
          "description": "A summary of what changed, what was validated, and any follow-ups.",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "FinalArgs",
      "type": "object"
    }
  },
  {
    "description": "Ask the user a question when you are genuinely blocked and cannot proceed without their input. Whenever you are asking for a decision, give `options`: 2–4 choices, each a short `label` (a few words) with a `description` of what it means, and mark the one you recommend with `recommended: true`. The user picks one from a list — or types their own answer, which is always available, so never add an \"other\" option. Keep the question itself to a few sentences; put the detail in the descriptions.",
    "name": "ask_user",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `ask_user` tool.",
      "properties": {
        "options": {
          "description": "The answers to choose between (2–4). The user can always type their own\nanswer instead, so do not add an \"other\" option.",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "properties": {
                  "description": {
                    "default": null,
                    "description": "One or two sentences on what this choice means or implies.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "label": {
                    "description": "A few words (≤ ~8) — what the user picks and what you get back.",
                    "type": "string"
                  },
                  "recommended": {
                    "default": false,
                    "description": "Mark the single option you recommend.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "label"
                ],
                "type": "object"
              }
            ],
            "description": "One option for `ask_user`: a short label, optionally with what it means and\nwhether you recommend it. A bare string is accepted as a label."
          },
          "type": [
            "array",
            "null"
          ]
        },
        "question": {
          "description": "The question. State the decision and the context needed to make it; keep it\nto a few sentences — detail belongs in each option's `description`.",
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "title": "AskUserArgs",
      "type": "object"
    }
  },
  {
    "description": "Delegate a focused, independent sub-task to a worker that shares this workspace/container. Describe the work by `category` (the kind of work — pick one your system prompt lists) and `effort` (tiny/small/medium/large/deep, judged on difficulty alone) — Cowboy routes it to the right model from the user's crew roster. Do NOT pick a model. Optionally set `agent` to adopt a named specialist definition from `.claude/agents/`/`.cowboy/agents/` (e.g. \"security-reviewer\"; discover with `cowboy agents list`). Include a `reason` and the `expected_artifact`. ASYNCHRONOUS: returns a job id immediately, NOT the worker's answer — keep working, and the result is delivered to you as a message when the job finishes (`jobs` to check, `wait` only when you have nothing else to do). Size each task to fit one worker's turn grant: split large work (per crate, module, or concern) and emit several calls in one message to run them in parallel.",
    "name": "subagent",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `subagent` tool.",
      "properties": {
        "agent": {
          "default": null,
          "description": "Optional: a named agent definition to adopt (from `.claude/agents/` or\n`.cowboy/agents/`, e.g. \"security-reviewer\"). Its instructions are\nprepended so the worker takes on that persona. Discover names with\n`cowboy agents list`. (The crew still picks the model from category/effort.)",
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "default": null,
          "description": "The KIND of work, so Cowboy routes it to the right crew model. Use one of\nthe categories listed in your system prompt (they come from the user's\nroster — typically general, exploration, backend, frontend, tests, docs,\ndebugging, refactor, e2e, review). Name the work by the artifact it\nproduces, not the subject it touches. An unlisted category silently falls\nback to `general`. Defaults to `general`. Do NOT name a model — routing is\nthe user's crew roster.",
          "type": [
            "string",
            "null"
          ]
        },
        "context": {
          "default": null,
          "description": "Optional extra context to prepend (the subagent starts with a fresh\nconversation, so include anything it needs to know).",
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "default": null,
          "description": "How hard the task is: tiny, small, medium, large, or deep. Defaults to\n`medium`. Sets BOTH the model and the worker's turn grant, so it is the\ncost dial — judge difficulty only, never urgency or importance. Your\nsystem prompt gives the turn count each level buys on this roster. When\ntorn between two levels, pick the lower: a worker can ask for more turns,\nbut an over-sized effort overpays on every token.",
          "type": [
            "string",
            "null"
          ]
        },
        "expected_artifact": {
          "default": null,
          "description": "The concrete artifact you expect back (e.g. \"changed test files + summary\").",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "default": null,
          "description": "Why you're delegating this (one line) — recorded with the routing decision.",
          "type": [
            "string",
            "null"
          ]
        },
        "task": {
          "description": "A focused, self-contained task for the subagent to complete.",
          "type": "string"
        }
      },
      "required": [
        "task"
      ],
      "title": "SubagentArgs",
      "type": "object"
    }
  },
  {
    "description": "List the background subagent jobs you have dispatched: state, how long each has been running, and its turn usage (used/granted, and the host ceiling it can be granted up to). Read-only — use it to decide whether to keep working, `wait`, or grant a worker more turns.",
    "name": "jobs",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `jobs` tool — no arguments; it lists everything.",
      "title": "JobsArgs",
      "type": "object"
    }
  },
  {
    "description": "Pause until a background subagent job reports — it finishes, or it asks for more turns. Use this ONLY when you have nothing else useful to do; results are delivered to you automatically either way, so waiting is never required to receive them. Returns early on a timeout so you are never stuck, and the user can always interrupt you.",
    "name": "wait",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `wait` tool.",
      "properties": {
        "all": {
          "default": null,
          "description": "Wait for *all* the named jobs (or all running jobs) instead of returning as\nsoon as the first one reports. Defaults to false.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "ids": {
          "default": null,
          "description": "Job ids to wait for. Omit to wait for whichever background job reports next.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "timeout_seconds": {
          "default": null,
          "description": "Give up waiting after this many seconds and return so you can do something\nelse. Defaults to a few minutes; capped by the host.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "title": "WaitArgs",
      "type": "object"
    }
  },
  {
    "description": "Answer a blocked subagent. Use `answer` (with your reply in `instructions`) when it asked a question about the work — it is asking you because you have the context it lacks. When it has spent its turn grant: `grant` gives it more turns, `redirect` gives it turns plus a different approach, `wrap_up` makes it write up what it has now, `stop` abandons it. For turn requests, judge the measured evidence in its report (files read, edits made, commands run, whether anything new happened) rather than its own optimism: no new files and no edits means more turns will not help.",
    "name": "job_reply",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `job_reply` tool.",
      "properties": {
        "id": {
          "description": "The job asking for more turns, or asking a question.",
          "type": "string"
        },
        "instructions": {
          "default": null,
          "description": "What to do differently — required for `redirect`, the reason for `stop`, and the\nreply itself for `answer`.",
          "type": [
            "string",
            "null"
          ]
        },
        "iterations": {
          "default": null,
          "description": "How many more turns to grant, for `grant`/`redirect`. The host clamps this to\nthe worker's remaining ceiling.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "verdict": {
          "description": "One of: `answer` (reply to a question), `grant` (more turns), `redirect` (more\nturns, different approach), `wrap_up` (stop exploring and write up what it has),\n`stop` (abandon it).",
          "type": "string"
        }
      },
      "required": [
        "id",
        "verdict"
      ],
      "title": "JobReplyArgs",
      "type": "object"
    }
  },
  {
    "description": "Ask your foreman for more turns, because the task is larger than the grant you were given. Report honestly: what you have established, what is left, the next concrete step, and how many more turns you need. You will be paused until the foreman answers — it may grant the turns, redirect you, tell you to write up what you have, or stop the work. Cowboy attaches measured evidence of your progress to the request, so an accurate report is in your interest.",
    "name": "request_turns",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Arguments for the `request_turns` tool (a delegated worker asking its foreman for\nmore turns).",
      "properties": {
        "iterations": {
          "description": "How many more turns you need to finish.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "next_step": {
          "description": "The single next concrete step you would take.",
          "type": "string"
        },
        "progress": {
          "description": "What you have established so far — concrete findings, not \"making progress\".",
          "type": "string"
        },
        "remaining": {
          "description": "What is still left to do.",
          "type": "string"
        }
      },
      "required": [
        "progress",
        "remaining",
        "next_step",
        "iterations"
      ],
      "title": "RequestTurnsArgs",
      "type": "object"
    }
  }
]
